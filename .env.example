# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (relational store: repos, findings, developers, scans, alerts) ---
DATABASE_URL=postgresql://secretsweep:secretsweep@localhost:5432/secretsweep

# --- Neo4j (Credential Data Flow Graph store) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# --- Redis (cache / job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=changeme-generate-a-long-random-value

# --- API auth (Phase 9): required value of the X-API-Key header. Leave unset in dev. ---
API_KEY=

# --- GitHub webhook signature verification (X-Hub-Signature-256). Leave unset in dev. ---
GITHUB_WEBHOOK_SECRET=

# --- Slack alerting ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/NOW

# --- JIRA auto-ticketing ---
JIRA_API_TOKEN=changeme
JIRA_PROJECT_KEY=SECSWEEP
JIRA_BASE_URL=https://your-domain.atlassian.net

# --- GitHub (repo access, Actions, key liveness checks) ---
GITHUB_TOKEN=changeme

# --- ML model paths ---
MODEL_PATH=./data/models/codebert-secretsweep
ONNX_MODEL_PATH=./data/models/codebert-secretsweep.onnx

# --- Runtime environment ---
ENVIRONMENT=development
